<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.VIBRATE" />
    <application android:allowBackup="false" android:fullBackupContent="false" android:dataExtractionRules="@xml/data_extraction_rules" android:hardwareAccelerated="true" android:label="${yomipaceAppLabel}" android:icon="@drawable/ic_yomipace" android:supportsRtl="true" android:theme="@style/AppTheme">
        <provider android:name=".SharedZipProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/share_paths" />
        </provider>
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="screenSize|smallestScreenSize|orientation|screenLayout|density|fontScale|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
